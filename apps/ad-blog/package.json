{
  "name": "@jinho-blog/ad-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "registry": "tsx scripts/registry.ts",
    "dev": "pnpm run registry && next dev -p 3402",
    "build": "pnpm run registry && next build",
    "lint": "concurrently \"pnpm run lf\" \"pnpm run eslint\" \"pnpm run type-check\"",
    "lf": "prettier --write -l --end-of-line lf src scripts",
    "eslint": "eslint src scripts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@jinho-blog/mdx-handler": "workspace:*",
    "@jinho-blog/shared": "workspace:*",
    "clsx": "^2.1.1",
    "image-size": "^2.0.2",
    "next": "^16.4.0",
    "next-mdx-remote-client": "^2.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-flexible-toc": "^1.2.4",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^1.1.5",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jinho-blog/thumbnail-generator": "workspace:*",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.7.10",
    "eslint-plugin-boundaries": "^5.3.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
